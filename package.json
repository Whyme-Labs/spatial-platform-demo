{
  "name": "spatial-studio-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "auth:init:local": "node scripts/init-local-auth.mjs",
    "check": "npm run types && npm run typecheck && npm run audit:actions && npm run audit:controls && npm run build && npm run test && npm run deploy:dry-run",
    "audit:actions": "node scripts/audit-action-state.mjs",
    "audit:controls": "node scripts/audit-control-wiring.mjs",
    "qa:browser:capture-bundle": "node scripts/browser-qa-capture-bundle.mjs",
    "qa:browser:raw-change": "node scripts/browser-qa-raw-scene.mjs",
    "qa:browser:semantic-extraction": "node scripts/browser-qa-semantic-extraction.mjs",
    "qa:browser:asset-handoff": "node scripts/browser-qa-asset-handoff.mjs",
    "deploy:dry-run": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler deploy --env production --dry-run",
    "deploy:production": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler deploy --env production",
    "deploy:staging": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler deploy --env staging",
    "dev": "npm run build && wrangler dev",
    "processor:once": "node scripts/processing-agent.mjs --once",
    "processor:setup": "node scripts/install-spark-processor.mjs",
    "processor:start": "node scripts/processing-agent.mjs",
    "capture-agent:once": "node scripts/capture-transfer-agent.mjs --once",
    "capture-agent:start": "node scripts/capture-transfer-agent.mjs",
    "processor:container:build": "docker build --platform linux/amd64 -f processor/Dockerfile -t spatial-processor:0.6.2 .",
    "processor:cloud:dry-run": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler deploy -c wrangler.processor.jsonc --env production --dry-run",
    "processor:cloud:staging": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler deploy -c wrangler.processor.jsonc --env staging",
    "processor:cloud:production": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler deploy -c wrangler.processor.jsonc --env production",
    "corpus:fetch": "node scripts/open-corpus.mjs fetch",
    "corpus:verify": "node scripts/open-corpus.mjs verify",
    "corpus:prepare": "node scripts/open-corpus.mjs prepare",
    "corpus:compat": "node scripts/open-corpus.mjs compat",
    "corpus:all": "node scripts/open-corpus.mjs all",
    "corpus:e2e:local": "node scripts/open-corpus-e2e.mjs",
    "db:migrate:local": "wrangler d1 migrations apply spatial-studio-local --local",
    "db:migrate:production": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler d1 migrations apply DB --env production --remote",
    "db:migrate:staging": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler d1 migrations apply DB --env staging --remote",
    "db:migrations:production:status": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler d1 migrations list DB --env production --remote",
    "db:migrations:staging:status": "CLOUDFLARE_ACCOUNT_ID=1e0170aaabc90ecf5f466128d1f0466a wrangler d1 migrations list DB --env staging --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "types": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playcanvas/splat-transform": "3.1.7",
    "@sparkjsdev/spark": "2.1.0",
    "fflate": "0.8.3",
    "hono": "^4.9.0",
    "three": "0.180.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@mkkellogg/gaussian-splats-3d": "0.4.7",
    "@types/node": "^24.0.0",
    "@types/three": "0.180.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  }
}
